{% set currentRoute = app.request.attributes.get('_route') %}
{% set selectedAgencyName = app.session.get('selected_agency_name') %}

<div data-controller="header" class="w-full mt-6">
    <div class="max-w-[1700px] mx-auto px-6 py-4">
        <div class="flex items-center justify-between gap-6">

            <!-- Logo -->
            <div class="shrink-0">
                <a href="{{ path('app_home') }}">
                    <img src="/images/Logo.png" alt="CarPilot" class="h-12 w-auto">
                </a>
            </div>

            <!-- Message bienvenue -->
            {% if selectedAgencyName %}
                <div class="flex-1 text-center min-w-0">
                    <p class="font-semibold text-gray-700 text-base lg:text-xl whitespace-nowrap">
                        Bienvenue sur votre agence de
                        <span class="text-orange-600">{{ selectedAgencyName }}</span>
                    </p>
                </div>
            {% else %}
                <div class="flex-1"></div>
            {% endif %}

            <!-- Navigation -->
            <div class="shrink-0">
                <nav class="hidden md:flex items-center gap-6">
                    <a href="{{ path('app_home') }}"
                       class="text-sm font-semibold hover:text-orange-500 whitespace-nowrap {{ currentRoute == 'app_home' ? 'text-orange-600' : '' }}">
                        Vendre ma voiture
                    </a>

                    <a href="{{ path('app_estimez_maintenant') }}"
                       class="text-sm font-semibold hover:text-orange-500 whitespace-nowrap {{ currentRoute == 'app_estimez_maintenant' ? 'text-orange-600' : '' }}">
                        Estimer ma voiture
                    </a>

                    <a href="#contact"
                       class="text-sm font-semibold hover:text-orange-500 whitespace-nowrap"
                       data-header-target="scrollLink">
                        Nous contacter
                    </a>

                    <a href="{{ path('app_astuces') }}"
                       class="text-sm font-semibold hover:text-orange-500 whitespace-nowrap {{ currentRoute == 'app_astuces' ? 'text-orange-600' : '' }}">
                        Nos articles
                    </a>

                    {% if app.user %}
                        {% set dashUrl = '/' %}
                        {% if is_granted('ROLE_ADMIN') %}
                            {% set dashUrl = path('admin_dashboard') %}
                        {% elseif is_granted('ROLE_AGENT') %}
                            {% set dashUrl = path('agent_dashboard') %}
                        {% elseif is_granted('ROLE_SELLER') %}
                            {% set dashUrl = path('seller_dashboard') %}
                        {% endif %}

                        <a href="{{ dashUrl }}"
                           class="text-sm font-semibold hover:text-orange-500 whitespace-nowrap">
                            Dashboard
                        </a>

                        <a href="{{ path('app_logout') }}"
                           data-controller="logout"
                           data-action="click->logout#logout"
                           class="text-sm font-semibold hover:text-orange-500 cursor-pointer whitespace-nowrap">
                            Déconnexion
                        </a>
                    {% else %}
                        <a href="{{ path('app_account') }}"
                           class="text-sm font-semibold hover:text-orange-500 whitespace-nowrap {{ currentRoute == 'app_account' ? 'text-orange-600' : '' }}">
                            Mon compte
                        </a>
                    {% endif %}

                    <!-- Menu agences -->
                    <div class="relative inline-block text-left shrink-0">
                        <button id="agencesButton"
                                data-header-target="button"
                                class="bg-orange-500 cursor-pointer hover:bg-orange-600 text-white px-6 py-2 rounded-full text-sm inline-flex items-center gap-1 focus:outline-none whitespace-nowrap">
                            <span>{{ selectedAgencyName ?? 'Nos agences' }}</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </button>

                        <div id="agencesMenu"
                             data-header-target="menu"
                             class="hidden origin-top-right absolute right-0 mt-1 w-40 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-50">
                            <div class="py-1" role="menu" aria-orientation="vertical" aria-labelledby="agencesButton">
                                {% for agency in agencyEntities %}
                                    <form method="POST" action="{{ path('web_public_select_agency', { id: agency.id }) }}">
                                        <button type="submit"
                                                class="w-full text-left block px-4 py-2 text-sm text-gray-700 hover:bg-orange-500 hover:text-white cursor-pointer">
                                            {{ agency.name }}
                                        </button>
                                    </form>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </nav>
            </div>

        </div>
    </div>
</div>

<div class="h-1 bg-orange-500 w-full my-4"></div>