<section class="relative overflow-hidden py-8 lg:py-12 lg:pb-65">

  <img
  src="{{ asset('images/renault-clio 1.png') }}"
  alt="Renault Clio blanche"
  class="hidden lg:block absolute -bottom-5 left-28 xl:left-40 w-[460px] xl:w-[520px] object-contain pointer-events-none select-none z-0"
/>

  <div class="relative z-10">
    <div
      class="mx-auto md:w-1/2 lg:w-2/3 xl:w-1/2 max-w-md lg:max-w-2xl mt-6 mb-10"
      data-controller="plate-prefill"
      data-plate-prefill-endpoint-value="{{ path('api_public_estimation_plate_lookup') }}"

      {# URL de redirection vers la page de formulaire d'estimation une fois les infos pré-remplies #}
      data-plate-prefill-redirect-value="{{ path('public_estimation_form') }}"

      {# URL de redirection vers la page de connexion si l'utilisateur n'est pas authentifié #}
      data-plate-prefill-login-value="{{ path('app_account', { redirect: path('public_estimation_form') }) }}"
    >
      <div class="bg-orange-500 text-white py-4 px-8 rounded-t-lg font-semibold text-center">
        Commencez la vente de votre véhicule ici !
      </div>

      <form class="bg-gray-100 p-10 rounded-b-lg" data-action="submit->plate-prefill#submit">
        <label class="block font-semibold mb-6 text-center">Pour immatriculation</label>

        <input
          type="text"
          placeholder="GW-713-AC"
          maxlength="9"
          class="w-full px-4 py-2 mb-4 rounded border border-gray-300 text-center font-mono text-lg bg-white"
          data-plate-prefill-target="plate"
          data-action="input->plate-prefill#onInput blur->plate-prefill#onBlur"
        >

        <p class="text-sm text-gray-500 mb-6 mt-2 text-center">
          Pour un pré-remplissage des informations rapide et fiable !
        </p>

        <button
          type="submit"
          class="w-full text-white px-6 py-3 rounded font-semibold transition bg-[#123354] hover:bg-[#3a5a7d] cursor-pointer"
          data-plate-prefill-target="btn"
        >
          ESTIMEZ MAINTENANT
        </button>

        <p class="text-sm mt-4 text-red-600 hidden text-center" data-plate-prefill-target="error"></p>
      </form>
    </div>
  </div>
</section>