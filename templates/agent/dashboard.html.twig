{% extends 'base.html.twig' %}

{% block title %}Dashboard agent{% endblock %}

{% block body %}
<main
  class="min-h-screen bg-gray-50 p-8"
  data-controller="agent-estimations"
  data-agent-estimations-list-url-value="/api/agent/estimations"
>
  <div class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold mb-6">Tableau de bord agent</h1>

    <div class="flex flex-wrap gap-3 mb-6">

        <button class="px-4 py-2 rounded-lg bg-white shadow hover:bg-gray-100"
              data-action="click->agent-estimations#filter"
              data-status="">
        Toutes les demandes
      </button> 

      <button class="px-4 py-2 rounded-lg bg-white shadow hover:bg-gray-100"
              data-action="click->agent-estimations#filter"
              data-status="offer_made">
        À traiter
      </button>

      <button class="px-4 py-2 rounded-lg bg-white shadow hover:bg-gray-100"
              data-action="click->agent-estimations#filter"
              data-status="in_review">
        En cours d’étude
      </button>
    </div>

    <div class="bg-white shadow-xl rounded-2xl overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-100 text-left">
            <tr>
               <th class="p-4">Véhicule</th>
                <th class="p-4">Client</th>
                <th class="p-4">Date estimation</th>
                <th class="p-4">Estimation</th>
                <th class="p-4">Offre vendeur</th>
                <th class="p-4">Statut</th>
                <th class="p-4 text-right">Actions</th>
            </tr>
        </thead>

        <tbody data-agent-estimations-target="tbody">
          <tr>
            <td class="p-4 text-gray-400" colspan="7">Chargement…</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</main>
{% endblock %}
