<!DOCTYPE html>
<html lang="fr-FR">
<head>
    <meta charset="UTF-8">
    {# <meta name="viewport" content="width=device-width, initial-scale=1.0"> #}
   
    <title>{% block title %}Carpilot - Vendre sa voiture facilement{% endblock %}</title>

    <meta name="description" content="{% block meta_description %}Carpilot vous accompagne pour vendre votre voiture rapidement, au meilleur prix et en toute confiance.{% endblock %}">
    <meta name="keywords" content="carpilot, vendre voiture, reprise auto, estimation véhicule, voiture occasion">
    <meta name="selected-agency-id" content="{{ app.session.get('selected_agency_id') }}">
    <meta http-equiv="Content-Language" content="fr">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

     {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body>
    {% block navbar %}
        <header class="bg-white shadow">
            {% include 'partials/_header.html.twig' %}
        </header>
    {% endblock %}

    {# Optionnel : barre de navigation verticale #}    
    {% block vnavbar %} {% endblock %}
        
    <main>
        {% block body %} {% endblock %}
    </main>

    {% block footer %}
        <footer class="bg-white pt-10">
            {% include 'partials/_footer.html.twig' %}
        </footer>
    {% endblock %}

     {#  Injection automatique du JWT après login #}
    {% if app.session.get('jwt') %}
        <script>
            localStorage.setItem("token", "{{ app.session.get('jwt') }}");
        </script>
        {% do app.session.remove('jwt') %}
    {% endif %}

</body>
</html>
