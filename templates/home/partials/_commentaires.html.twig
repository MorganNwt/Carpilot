<!-- Flèche vers le bas -->
<div class="absolute -top-16 left-1/2 -translate-x-1/2">
    <div class="bg-orange-500 border-15 border-white rounded-full w-24 h-24 flex items-center justify-center shadow-lg">
        <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" stroke-width="3"
             viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
    </div>
</div>

<h2 class="text-2xl font-bold mt-6 mb-12 text-center">Ils nous ont adorés !</h2>

<!-- CONTAINER GLOBAL CENTRÉ -->
<div data-controller="commentaire" class="w-full flex justify-center mt-10 px-4">

    <!-- CONTENEUR EXTERNE -->
    <div class="relative w-full max-w-[1200px] px-16">

        <!-- ZONE MASQUÉE DE défilement -->
        <div class="overflow-hidden">

            <!-- FLÈCHE GAUCHE -->
            <button 
                data-commentaire-target="prev"
                data-action="click->commentaire#prevSlide"
                class="absolute left-0 top-1/2 -translate-y-1/2 z-20 bg-orange-500 w-16 h-16 rounded-full flex items-center justify-center shadow-lg cursor-pointer"
            >
                <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" stroke-width="4"
                     viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>

            <!-- CAROUSEL (le conteneur qui glisse) -->
            <div 
                data-commentaire-target="carousel"
                class="flex gap-10 transition-transform duration-500"
            >
                {% set reviews = [
                    {
                        img: '/images/photo-avis-1.png',
                        name: 'Charles HENRY',
                        text: 'Incroyable, ma voiture est estimée et vendue<br>en quelques clics seulement !'
                    },
                    {
                        img: '/images/photo-avis-2.png',
                        name: 'Iness DEKLAPE',
                        text: 'Très satisfaite du service, rapidité et fiabilité<br>au rendez-vous. Je recommande !'
                    },
                    {
                        img: '/images/photo-avis-1.png',
                        name: 'Julien MARCHEL',
                        text: 'Service nickel, estimation rapide et sérieuse, je recommande !'
                    },
                    {
                        img: '/images/photo-avis-2.png',
                        name: 'Sarah LEMOINE',
                        text: 'Rachat immédiat et prix au top ! Rien à dire.'
                    }
                ] %}

                {% for r in reviews %}
                    <div 
                        data-commentaire-target="card"
                        class="review-card relative bg-white text-gray-800 rounded-xl p-6 pt-24 pb-18
                               w-[500px] flex-shrink-0 shadow-lg overflow-visible"
                    >
                        <!-- PHOTO DÉBORDANTE -->
                        <div class="absolute -top-0 left-8 mt-2">
                            <img src="{{ r.img }}"
                                 class="w-20 h-20 rounded-full border-4 border-white shadow-xl">
                        </div>

                        <div class="text-center">
                            <h3 class="font-bold text-lg">{{ r.name }}</h3>
                            <p class="text-sm mb-5">{{ r.text|raw }}</p>
                        </div>

                        <div class="absolute left-6 bottom-4 flex items-center gap-2">
                            <img src="/images/google.png" class="w-6 h-6">
                            <div class="flex gap-1">
                                {% for i in 1..5 %}⭐{% endfor %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- FLÈCHE DROITE -->
        <button 
            data-commentaire-target="next"
            data-action="click->commentaire#nextSlide"
            class="absolute right-0 top-1/2 -translate-y-1/2 z-20 bg-orange-500 w-16 h-16 rounded-full flex items-center justify-center shadow-lg cursor-pointer"
        >
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" stroke-width="4"
                 viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
        </button>

    </div>
</div>
