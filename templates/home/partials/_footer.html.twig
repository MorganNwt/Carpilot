{% block stylesheets %}

<style>
    .back-to-top {
        position: fixed;
        bottom: 5em; /* plus haut que le bas de page */
        right: 2em;
        width: 2.5em;
        height: 2.5em;
        background-color: #ff8c00; /* orange */
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 24px;
        text-decoration: none;
        box-shadow: 0px 4px 6px rgba(0,0,0,0.2);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        z-index: 1000;
    }

    /* opacité 50% quand visible */
    .back-to-top.show {
        opacity: 0.5;
        pointer-events: auto;
    }

    /* hover : devient 100% opaque */
    .back-to-top:hover {
        opacity: 1;
    }
</style>
{% endblock %}

{% block javascript %}

<script>
    document.addEventListener("scroll", () => {
    const button = document.getElementById("backToTop");

    // hauteur totale du document
    const docHeight = document.documentElement.scrollHeight;
    
    // hauteur visible
    const winHeight = window.innerHeight;
    
    // scroll actuel (distance parcourue)
    const scrollTop = window.scrollY;

    // si l'utilisateur est en bas de page
    if (scrollTop + winHeight >= docHeight - 100) {
        button.classList.add("show");
    } else {
        button.classList.remove("show");
    }
});
</script>
{% endblock %}

