<!-- Formulaire de contact -->
<div class="max-w-4xl mx-auto bg-orange-500 text-white p-6 rounded shadow-md mb-10 mt-10">
    <form method="post" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label for="prenom" class="block text-sm font-medium mb-1">Prénom</label>
            <input type="text" id="prenom" name="prenom" placeholder="Votre prénom"
                    class="w-full p-2 rounded text-black">
        </div>
        <div>
            <label for="email" class="block text-sm font-medium mb-1">Email</label>
            <input type="email" id="email" name="email" placeholder="Votre Email"
                    class="w-full p-2 rounded text-black">
        </div>
        <div class="md:col-span-2">
            <label for="message" class="block text-sm font-medium mb-1">Question</label>
            <textarea id="message" name="message" placeholder="Votre message"
                        class="w-full p-2 h-28 rounded text-black"></textarea>
        </div>
        <div class="md:col-span-2">
            <button type="submit"
                    class="bg-blue-900 hover:bg-blue-800 text-white px-4 py-2 rounded">
                Envoyez !
            </button>
        </div>
    </form>
</div>

