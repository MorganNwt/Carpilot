 <h2 class="text-3xl font-bold text-[#0b2c4c] mb-10 text-center">
    Retrouvez nous en agence !
</h2>

<div class="flex flex-col-reverse lg:flex-row items-center lg:items-start justify-center gap-10 w-full mx-auto mt-5">
    <!-- COLONNE GAUCHE : CARDS SCROLLABLES -->
    <div class="relative w-[500px] h-[600px] overflow-y-scroll pr-6">

        {% for agency in agencies %}
            <div class="bg-white rounded-xl shadow-xl border p-10 mb-10">
                <h3 class="text-2xl font-bold text-[#0b2c4c] mb-6">{{ agency.name }}</h3>

                <div class="space-y-5 text-gray-700">
                    <p class="flex items-start">
                        <i class="fas fa-map-marker-alt text-orange-400 text-xl mt-1 mr-3"></i>
                        {{ agency.address }}
                    </p>

                    <p class="flex items-start">
                        <i class="fas fa-calendar-alt text-orange-400 text-xl mt-1 mr-3"></i>
                        {{ agency.hours }}
                    </p>

                    <p class="flex items-start">
                        <i class="fas fa-phone-alt text-orange-400 text-xl mt-1 mr-3"></i>
                        {{ agency.phone }}
                    </p>

                    <p class="flex items-start">
                        <i class="fas fa-envelope text-orange-400 text-xl mt-1 mr-3"></i>
                        {{ agency.email }}
                    </p>
                </div>

                <div class="mt-8 flex gap-4">
                    <a href="#" class="px-6 py-3 border border-[#0b2c4c] text-[#0b2c4c] font-semibold rounded-lg hover:bg-[#0b2c4c] hover:text-white transition">
                        Voir l'agence
                    </a>

                    <a href="https://www.google.com/maps/dir/?api=1&destination={{ agency.map }}"
                    class="px-6 py-3 bg-orange-400 text-white font-semibold rounded-lg hover:bg-orange-500 transition flex items-center gap-2">
                        Se rendre à l'agence 
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>


    <!-- COLONNE DROITE : GOOGLE MAP -->
    <div class="sm:mb-10">
        <iframe
            width="600"
            height="600"
            style="border:0; border-radius: 20px;"
            loading="lazy"
            allowfullscreen
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d89094.26035074639!2d4.8151418!3d44.9333939!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47f557e4d0b3e6ad%3A0x408ab2ae4baeff0!2sValence!5e0!3m2!1sfr!2sfr!4v1713275592476">
        </iframe>
    </div>
</div>