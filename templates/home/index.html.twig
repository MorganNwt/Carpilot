{% extends 'base.html.twig' %}

{% block title %}Accueil - CarPilot{% endblock %}

{% block javascript %}
<script>
    let index = 0;
    const carousel = document.getElementById("carousel-inner");
    const totalSlides = carousel.children.length;

    document.getElementById("next").addEventListener("click", () => {
        index = (index + 1) % totalSlides;
        carousel.style.transform = `translateX(-${index * 100}%)`;
    });

    document.getElementById("prev").addEventListener("click", () => {
        index = (index - 1 + totalSlides) % totalSlides;
        carousel.style.transform = `translateX(-${index * 100}%)`;
    });
</script>
{% endblock %}

{% block body %}

<!-- Section pilotez la vente -->
<section class="bg-white py-12 text-center mb-10">
      {% include 'home/partials/_pilotezLaVenteImmatriculation.html.twig' %}
</section>

<!-- Section commentares -->
<section class="bg-orange-500 py-12 text-white text-center relative">
     {% include 'home/partials/_commentaires.html.twig' %}
</section>

<!-- Section comment vendre-->
<section class="container mx-auto px-4 py-10 flex flex-col items-center">
     {% include 'home/partials/_commentVendre.html.twig' %}
</section>

<!-- Section estimez maintenant-->
<section class="bg-[#0b2c4c] text-white py-10">
    {% include 'home/partials/_estimezMaintenant.html.twig' %}
</section>

<!-- Section google maps intégration -->
<section class="w-full flex flex-col items-center mt-10">
    {% include 'home/partials/_cardsAndGoogleMapsIntegration.html.twig' %}
</section>

{% endblock %}