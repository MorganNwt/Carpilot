{% extends 'base.html.twig' %}

{% block title %}Accueil - CarPilot{% endblock %}

{% block javascript %}{% endblock %}

{% block body %} 

<!-- Section pilotez la vente -->
<section class="bg-white py-12 text-center mb-10">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">Pilotez la vente de votre véhicule</h1>
     <p class="text-gray-600 mb-10 mx-auto">
        Estimez la valeur de votre voiture, obtenez immédiatement votre prix de vente et prenez rendez-vous en ligne : voilà, votre voiture est vendue !
    </p>
      {% include 'partials/_pilotezLaVenteImmatriculation.html.twig' %}
</section>

<!-- Section commentares -->
<section class="bg-orange-500 py-12 text-white text-center relative">
     {% include 'partials/_commentaires.html.twig' %}
</section>

<!-- Section comment vendre-->
<section class="container mx-auto px-4 py-10 flex flex-col items-center">
     {% include 'partials/_commentVendre.html.twig' %}
</section>

<!-- Section comment faire-->
<section class="bg-[#0b2c4c] text-white py-10">
    {% include 'partials/_commentFaire.html.twig' %}
</section>

<!-- Section google maps intégration -->
<section class="w-full flex flex-col items-center mt-20">
    {% include 'partials/_cardsAndGoogleMapsIntegration.html.twig' %}
</section>

<!-- Section astuces-->
<section class="py-16 mt-20 bg-[#002f5a]">
    <h2 class="text-center text-white text-3xl md:text-4xl font-bold mt-10 mb-15">
        Nos astuces pour vendre votre voiture
    </h2>
    {% include 'partials/_astuces.html.twig' %}
</section>

<!-- Section question réponse-->
<section class="max-w-4xl mx-auto py-10 mt-20">
    {% include 'partials/_questionReponses.html.twig' %}
</section>

{% endblock %}